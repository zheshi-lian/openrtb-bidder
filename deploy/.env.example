# 生产环境变量样例：复制为 .env 后填入真实值
# ⚠️ 不要把 .env 提交到 GitHub

# ---- 运行模式：设为 production 后，安全模块会强制校验下方密钥，缺失则拒绝启动 ----
NODE_ENV=production
PORT=8080

# ---- 必填密钥（生产缺失直接拒绝启动）----
# 管理员令牌：后台所有写操作与报表读取都需要它
ADMIN_TOKEN=请填入至少16位随机串
# 奖励/结算令牌签名密钥（HMAC-SHA256）
RW_SECRET=请填入至少16位随机串
# 数据库凭据：绝不使用代码内默认值
DB_USER=adx
DB_PASSWORD=强密码
DB_NAME=zhuque
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- 生产必须：共享缓存（竞价状态/相关性缓存持久化）----
# 先起 Redis：docker compose -f deploy/docker-compose.yml up -d
REDIS_URL=redis://127.0.0.1:6379

# ---- 管理面 CORS 白名单（竞价/上报路径对第三方保持开放，不在此列）----
ALLOWED_ORIGINS=https://dellai.xyz,https://www.dellai.xyz

# ---- 可选 ----
# PM2 实例数
PM2_INSTANCES=2
# mysqldump 路径（备份脚本找不到时自动探测）
# MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# 反欺诈：设为 1 强制客户端上报需等服务端 S2S 回调
S2S_ENFORCE=0
