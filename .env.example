# 意图 Agent 真实 LLM 接入配置
# 复制本文件为 .env 并填入对应 Key 即可。未配置时平台自动回落到启发式（仍可运行）。

# 选择供应商：dashscope(通义千问) | openai | deepseek | sensenova
LLM_PROVIDER=sensenova

# 商汤 Sensenova（OpenAI 兼容） https://www.sensenova.cn
SENSENOVA_API_KEY=sk-your-sensenova-key

# 通义千问（DashScope） https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 可选：覆盖默认模型
#   dashscope 默认 qwen-plus；openai 默认 gpt-4o-mini；deepseek 默认 deepseek-chat
LLM_MODEL=

# 是否在竞价热路径启用 LLM 相关性评分（=0 关闭，仅在创建/抽取/演示时用 LLM，热路径用启发式）
LLM_LIVE_MATCH=1
