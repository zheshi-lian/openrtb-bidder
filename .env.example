# ============================================================
# dellai.xyz ADX 平台 · 生产环境配置清单
# 用法：本地开发可从默认值启动。生产环境必须设置 NODE_ENV=production，
#       并配置下列安全项与独立数据库凭据；不得将本文件中的示例默认值直接用于公网服务。
# .env 由 llm.js 内置的极简解析器加载，无需安装 dotenv。
# ============================================================

# ---------- 服务基础 ----------
PORT=8080
# ★ ADX 对公网暴露的域名（VAST/奖励/回调等公开 URL 前缀）。生产填 https://dellai.xyz
PUBLIC_BASE=https://dellai.xyz
# 媒体服务端地址（App 服务端做 S2S 结算的参考实现，默认本机 8081；公网单端口经 /ms 代理无需改）
MEDIA_SERVER=http://127.0.0.1:8081

# ---------- 数据库（★ 生产改独立实例，勿用 demo 账号）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test@fftime
DB_NAME=zhuque

# ---------- 安全 / 结算 ----------
# 生产必填：显式设置 NODE_ENV=production；会校验 ADMIN_PASS 长度至少 12 位。
# 演示账号在生产启动时停用。
# NODE_ENV=production
ADMIN_USER=
ADMIN_PASS=
# 仅本地演示使用；生产环境永远忽略该项。
ENABLE_DEMO_ACCOUNTS=1
# ADMIN_TOKEN 与 RW_SECRET 在生产至少 16 字符；应分别使用独立随机密钥。
ADMIN_TOKEN=
ACCOUNT_SECRET=
# ★ 服务端奖励令牌 HMAC 密钥。生产必须改成强随机值，切勿用默认值！
RW_SECRET=
# 是否强制 S2S 结算（=1：客户端 /ssp/reward 只登记"待确认"，只有媒体服务端签名回调
#   /s2s/reward 才是权威——防刷量）。建议：接入了真实媒体服务端后再设为 1
S2S_ENFORCE=1

# ---------- 创意 / 可见性 ----------
# OMID 可见性度量 JS 的公开地址（生产填你的域名）
OMID_JS=https://dellai.xyz/omid-session.js
# 默认激励视频素材（VAST 中可覆盖）；可换成你自己的样例视频
RW_MEDIA=https://media.w3.org/2010/05/sintel/trailer.mp4

# ---------- 意图 Agent 真实 LLM 接入（未配置则启发式回落，仍可运行）----------
# 供应商：dashscope(通义千问) | openai | deepseek | sensenova | custom(任意 OpenAI 兼容 /v1/chat/completions)
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.justwoker.icu/v1
LLM_API_KEY=sk-your-custom-key
SENSENOVA_API_KEY=sk-your-sensenova-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 模型（custom 供应商必填，如 claude-opus-4-8）
LLM_MODEL=claude-opus-4-8
# 竞价热路径是否启用 LLM 相关性评分（=1 启用；带 900ms 预算、超时回落启发式，更稳更省）
LLM_LIVE_MATCH=1
# 可选：覆盖 embedding 模型（openai=text-embedding-3-small / dashscope=text-embedding-v2）。
# 用于"异步缓存化相关性"——热路径不阻塞，向量在后台计算并缓存，无需额度即可跑（回落启发式）。
EMBED_MODEL=

# ---------- 规模化底座（可降级，不填也能跑）----------
# 可选：Redis 连接串。填了且 npm i ioredis 即切换为共享缓存（pubMetaCache/相关性/embedding 重启不丢，水平扩展共享状态）。
# 不填则用内存缓存，单机可跑。
REDIS_URL=
# 可选：外部 SSP 聚合（类 AppLovin MAX 的"中介聚合多供给"）。JSON 数组，默认空=不生效。
# 例：SUPPLY_PARTNERS=[{"name":"ssp-b","url":"https://b.example.com/openrtb2/bid"}]
SUPPLY_PARTNERS=

# ---------- 快手磁力引擎 开放平台 · DSP/买量侧（真实对接 + sim 兜底）----------
# 我们的平台 = DSP + SSP + ADX，核心聚合长尾流量做供给，快手是真实可用的需求/买量来源。
# 默认 sim（不联网，返回模拟成交）；设 KS_MODE=real 并填下方凭据 + 回调地址后走 OAuth2 真实对接。
# 注：巨量引擎为封闭花园（须在其内部完成投放）不在此对接；汇量/Appluck 为同类竞争对手。
KS_MODE=sim
KS_APP_ID=
KS_APP_SECRET=
KS_REDIRECT_URI=https://dellai.xyz/api/demand/kuaishou/oauth-callback
KS_API_BASE=https://ad.e.kuaishou.com
KS_OPEN_BASE=https://open.kuaishou.com

# ============================================================
# 补齐 AppLovin 差距新增的配置项（全部可选，不填即回落默认值）
# ============================================================

# ---------- 供给信任层（ads.txt / app-ads.txt / sellers.json）----------
# ★ 我们作为交易所的域名与 seller_id：必须与媒体方 ads.txt 里声明的完全一致，
#   否则买方校验会判"未授权库存"（表现为被压价或不采买）
EXCHANGE_DOMAIN=dellai.xyz
EXCHANGE_SELLER_ID=1
TRUST_CONTACT=adops@dellai.xyz
TRUST_CERT_AUTHORITY=iabtechlab.com

# ---------- 身份图谱（post-ATT 设备图）----------
# ★ ID 哈希盐：改了它，历史所有哈希标识全部失效（等于图谱重建），切勿随意变更
ID_HASH_SECRET=change-me-identity-salt
# 概率连边阈值（0~1）。调低=更激进合并（召回高、误连多）；调高=更保守
ID_LINK_THRESHOLD=0.72

# ---------- 竞价工程 ----------
# 竞价接口 QPS 硬上限（0=不限）。超限请求直接 503 快速失败，避免雪崩
BID_QPS_LIMIT=0
# p99 延迟目标（毫秒）。超目标时自适应限流会自动收紧容量（AIMD）
BID_P99_TARGET_MS=10
DSP_P99_TARGET_MS=50
# 冷启动胜率模型的市场参考 CPM（micros），用于无数据时的先验
MARKET_REF_CPM_MICROS=5000000

# ---------- ML 平台 ----------
# 特征落库采样率（0~1）：高 QPS 下调低可避免特征日志表被打爆
FEATURE_LOG_RATE=0.2
ML_FLUSH_MS=30000
# LinUCB 探索强度：越大越倾向探索
BANDIT_ALPHA=0.6

# ---------- 品牌安全 / 第三方验证 ----------
# 验证厂商脚本地址（填了才会注入 VAST <AdVerifications>）；未配置则仅本地 OMID
IAS_VERIFICATION_URL=
DV_VERIFICATION_URL=
MOAT_VERIFICATION_URL=

# ---------- SKAN 归因 ----------
# Apple 提供的 SKAdNetwork 公钥（PEM，ECDSA P-256），用于回传验签。
# 未配置时回传仍接收但标记未验签；设 SKAN_SKIP_VERIFY=1 可跳过验签（仅调试）
SKAN_PUBKEY_PEM=
SKAN_SKIP_VERIFY=0

# ---------- 计费 ----------
# 发票税率（现代服务业增值税默认 6%）与账期天数
INVOICE_TAX_RATE=0.06
PAYMENT_TERMS_DAYS=30

# ============================================================
# 运维 / 可观测性 / 告警（补齐 AppLovin 差距：告警有人看）
# ============================================================

# ---------- 业务告警外发（企微/飞书/Slack 机器人）----------
# 填机器人 Webhook 后，checkAlerts 触发的告警会同时推送到群（否则仅落库 alerts 表，控制台可见）。
# 飞书：https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 企微：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# Slack 等：填通用 JSON 接收地址即可（payload 为 {level,kind,msg,metric}）
ALERT_WEBHOOK=
# 飞书机器人若在安全设置里开启"签名校验"，在此填机器人的签名密钥（secret）；不开则留空
ALERT_WEBHOOK_SECRET=

# ---------- DB 自动备份专用账号（scripts/backup_db.ps1 使用）----------
# 默认复用业务账号 test；但它无 RELOAD/FLUSH_TABLES 权限，只能做"无锁非一致快照"。
# 要做"完全一致快照"，请用 root 建专用账号并 GRANT RELOAD, FLUSH_TABLES, LOCK TABLES, SELECT ON *.*，
# 然后在此填入（见 backup_db.ps1 顶部说明）。
BACKUP_DB_USER=test
BACKUP_DB_PASS=test@fftime
